# Données d'exécution (état de jeu — hors repo, monté en volume).
# Depuis l'auth, chaque compte a son sous-dossier data-<type>/<user_id>/ :
# on ignore tout le contenu, en conservant uniquement les .gitkeep de la racine.
data-perso/**
data-combat/**
data-campagne/**
!data-perso/.gitkeep
!data-combat/.gitkeep
!data-campagne/.gitkeep

# Base d'authentification (comptes, hors repo — monté en volume).
data-auth/

# Qdrant local
.qdrant/

# Logs / OS
logs/
*.log
.DS_Store

# Artefacts runtime (moteur écrit ici en chemin relatif pendant les tests)
packages/data-combat/
