# Binaire SRD suivi par Git LFS (le PDF source de ~380 p. ne doit pas alourdir le repo)
*.pdf filter=lfs diff=lfs merge=lfs -text

# Fichiers texte : normalisation des fins de ligne
*.py text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Verrouillages / binaires à ne pas diff
package-lock.json binary
pnpm-lock.yaml binary
