# ─── Identité / réseau ───────────────────────────────────────────
# L'app est exposée sur rpg.minervia.fr (routeur Traefik `mj-web`, priorité 100).
# La chaîne DNS + Caddy pour rpg.minervia.fr existe déjà (cf. routing-architecture) ;
# seul le routeur Traefik est ajouté ici. L'ancien routeur nginx `rpg` de l'autre
# stack doit être retiré / abaissé sous la priorité 100 pour libérer l'hôte.
APP_HOST=rpg.minervia.fr
# Réseau docker de la stack LLM existante (qwen_3.8_vnimanieAI) à rejoindre.
DOCKER_NETWORK=mynetwork

# ─── Backend (apps/api) ──────────────────────────────────────────
# Clé partagée injectée par Traefik en en-tête X-API-Key (jamais côté navigateur).
DND_API_KEY=change-me
# ─── Authentification par compte (email + mot de passe) ─────────
# Secret de signature des sessions et des liens email. DOIT être identique
# entre `web` et `api`. Générer : python3 -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=change-me
# Durée de vie d'une session (cookie), en secondes. Défaut : 30 jours.
SESSION_DUREE_S=2592000
# Durée de validité des liens de vérification / réinitialisation (1 h).
LIEN_DUREE_S=3600
# URL publique de l'app (liens des emails).
BASE_URL=https://rpg.minervia.fr
# SMTP (optionnel). Sans SMTP_HOST, les emails passent en mode console (loggés).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_STARTTLS=1
# Répertoires d'état de jeu (montés en volume dans le conteneur).
DND_PERSO_DIR=/app/data/perso
DND_COMBAT_DIR=/app/data/combat
DND_CAMPAGNE_DIR=/app/data/campagne

# ─── LLM (OpenAI-compatible, via litellm de la stack existante) ──
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=change-me
# Modèle servi (auto-détectable via GET /v1/models).
MJ_MODEL=VnimanieAI/Qwen3.8-Flash-Next-W4A16

# ─── Embeddings (service embedding de la stack existante) ────────
EMBED_BASE_URL=http://embedding:8080/v1
EMBED_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B

# ─── RAG / Qdrant ────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=srd_521
RAG_TOP_K=5
